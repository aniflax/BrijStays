    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "alt": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
