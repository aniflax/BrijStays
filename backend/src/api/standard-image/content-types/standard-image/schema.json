{
  "kind": "collectionType",
  "collectionName": "standard_images",
  "info": {
    "singularName": "standard-image",
    "pluralName": "standard-images",
    "displayName": "Standard Images",
    "description": "Image grid shown in the Brij Stays Standard homepage section"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
