###############################################################################
# Brij Stays backend environment template
#
# Use this file for local development and as the source of truth for Render
# production env vars. Do not commit real secrets.
###############################################################################

# Server
HOST=0.0.0.0
PORT=1337

# Database
# Local development can stay on SQLite unless you explicitly switch it.
# For production on Render:
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_SSL=true
# DATABASE_SCHEMA=public

# Strapi secrets
APP_KEYS="replace-me-1,replace-me-2,replace-me-3,replace-me-4"
ADMIN_JWT_SECRET=replace-me
API_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
ENCRYPTION_KEY=replace-me

# R2 / S3 media storage
# Set these only when connecting Strapi to Cloudflare R2.
# R2_ACCESS_KEY_ID=replace-me
# R2_SECRET_ACCESS_KEY=replace-me
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# R2_MEDIA_BUCKET=replace-me
# R2_MEDIA_PUBLIC_URL=https://cdn.example.com
# R2_SECONDARY_BUCKET=replace-me
# R2_SECONDARY_PUBLIC_URL=https://cdn.example.com

# CORS
# Comma-separated list of frontend origins allowed to call the API.
# CORS_ORIGINS=https://brijstays.com,https://www.brijstays.com
