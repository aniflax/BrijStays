###############################################################################
# Brij Stays backend environment template
#
# Use this file for local development and as the source of truth for Render
# production env vars. Do not commit real secrets.
###############################################################################

# Server
HOST=0.0.0.0
# Render overrides PORT at runtime via its own service settings.
PORT=1337
# Public URL of this backend. Also used to set the admin cookies correctly.
PUBLIC_URL=https://admin.brijstays.in

# Database
# Local development can stay on SQLite unless you explicitly switch it.
# For production on Render (Neon PostgreSQL):
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_SSL=true
# DATABASE_SCHEMA=public

# Strapi secrets (generate real random values; never commit them)
APP_KEYS="comma,separated,list,of,keys"
ADMIN_JWT_SECRET=replace-me
API_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
ENCRYPTION_KEY=replace-me

# R2 / S3 media storage (Cloudflare R2)
# R2_ACCESS_KEY_ID=<access key id>
# R2_SECRET_ACCESS_KEY=<secret access key>
# R2_ENDPOINT=https://ed6340bb676b682ed2123087e001c205.r2.cloudflarestorage.com
# S3_REGION=auto
# R2_BUCKET_NAME=brijstays
R2_MEDIA_PUBLIC_URL=https://cdn.brijstays.in
# R2_SECONDARY_BUCKET=replace-me
# R2_SECONDARY_PUBLIC_URL=https://cdn.example.com

# CORS
# Comma-separated list of frontend origins allowed to call the API.
# Use explicit schemes; Strapi compares against the Origin header.
CORS_ORIGINS=https://brijstays.in,https://www.brijstays.in
